# Copy to .env and fill in. Never commit .env.

# SQLite file (relative to the project root). For Postgres use a postgres:// URL
# and swap the adapter in src/lib/db.ts.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=""

# Where uploaded images are stored (relative to the project root or absolute).
UPLOAD_DIR="./uploads"

# Public URL of the site (used for share links / metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
